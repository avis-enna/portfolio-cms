{
  "name": "portfolio-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=src/.*\\.(test|spec)\\.(js|jsx|ts|tsx)$",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "setup": "node scripts/setup.js",
    "deploy": "node scripts/deploy.js",
    "config:reset": "rm -rf config/*.json && npm run setup",
    "config:backup": "cp -r config config-backup-$(date +%Y%m%d-%H%M%S)",
    "config:restore": "cp -r config-backup-* config",
    "postinstall": "node scripts/check-setup.js || true",
    "test:e2e:cypress": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:e2e:cypress:open": "start-server-and-test dev http://localhost:3000 cypress:open",
    "test:all": "npm run test:ci && npm run test:e2e",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@tanstack/react-query": "^5.85.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.2",
    "next": "15.5.0",
    "openai": "^5.15.0",
    "ra-data-json-server": "^5.10.1",
    "react": "19.1.0",
    "react-admin": "^5.10.1",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "cypress": "^15.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^16.1.5",
    "msw": "^2.10.5",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.0.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
